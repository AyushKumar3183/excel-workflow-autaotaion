# ==============================================================================
# Google Gemini & ADK Configuration
# ==============================================================================

# Required for live LLM routing & generation (WF004, WF007, WF008, etc.)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Anthropic Claude Fallback Configuration
# ==============================================================================

# High-availability fallback model if Gemini fails (e.g. 429 quota, rate-limit, timeout)
# Get your API key from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model to use as fallback (default: claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Workspace ID added to header 'anthropic-workspace-id' for multi-workspace access
ANTHROPIC_WORKSPACE_ID=wrkspc_01YFjk7sHarCu1eJBpiitzFR

# ==============================================================================
# Optional System Paths & Logging
# ==============================================================================

# Custom workbook path (default: data/workflows_working.xlsx)
# WORKBOOK_PATH=data/workflows_working.xlsx

# Execution trace log path (default: data/workflow_logs.jsonl)
# LOG_FILE_PATH=data/workflow_logs.jsonl
